{
  "manifest_version": 3,
  "name": "ЯКласс Помощник (Gemini)",
  "version": "0.2.5",
  "description": "Автоматически выполняет задания и проходит теорию на yaklass.ru с помощью Google Gemini.",
  "permissions": ["storage", "scripting", "activeTab", "tabs"],
  "host_permissions": [
    "https://www.yaklass.ru/*",
    "https://yaklass.ru/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.yaklass.ru/*", "https://yaklass.ru/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ЯКласс Помощник",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
